# MongoDB Atlas connection string
# Replace <username>, <password>, and <cluster-url> with your Atlas credentials.
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-url>/budget-tracker?retryWrites=true&w=majority"
# Optional: overrides which database name on the cluster to use. If unset, defaults to
# "budget_tracker_dev" locally and "budget_tracker" when NODE_ENV=production, so local
# development never touches production data even when sharing the same MONGODB_URI cluster.
MONGODB_DB_NAME=budget_tracker_dev
PORT=4000
